#!/bin/bash
# ============================================================
# LSF job script: ABLE (receive-only), full scale, MVDR-NS target --
# the professor's primary ask for the ABLE side (paper's own approach).
# Full-scale counterpart of config/submit_job_able_mvdr_target.lsf.
#
# Submit with:  bsub < config/submit_job_able_mvdr_fullscale.lsf
# Monitor with: python scripts/status.py --checkpoint_dir Trained_Checkpoints/checkpoints_fullscale_able_mvdr
# ============================================================

#BSUB -J able_mvdr_fullscale
#BSUB -o Trained_Checkpoints/checkpoints_fullscale_able_mvdr/lsf_%J.out
#BSUB -e Trained_Checkpoints/checkpoints_fullscale_able_mvdr/lsf_%J.err

#BSUB -q BatchGPU
#BSUB -n 4
#BSUB -R "rusage[mem=16000]"
#BSUB -gpu "num=1:mode=exclusive_process:mps=no"
#BSUB -W 72:00

#BSUB -B
#BSUB -N

set -euo pipefail

echo "Job  : $LSB_JOBID  on $(hostname) at $(date)"
module purge
module load cuda/v12.2
source "$HOME/able_env/bin/activate"
nvidia-smi --query-gpu=name,memory.total,memory.used,utilization.gpu --format=csv,noheader || true

PROJECT_DIR="$HOME/Documents/Research Project"
cd "$PROJECT_DIR"
mkdir -p Trained_Checkpoints/checkpoints_fullscale_able_mvdr

# Full-scale (M=64, nx=128, nz=128 -- the defaults), receive-only,
# target_mode=mvdr. Same 100-epoch budget as the GT run for a fair
# apples-to-apples comparison (same architecture, same steps, different
# target only). lam_bg stays 0 -- hard-blocked otherwise.
python scripts/run_training.py \
    --n_steps        10000      \
    --batch_size     4          \
    --lr             1e-3       \
    --lam            0.8        \
    --noise_level    0.05       \
    --scatterer_type mixed      \
    --target_mode    mvdr       \
    --checkpoint_dir Trained_Checkpoints/checkpoints_fullscale_able_mvdr

echo "Job finished at $(date)"
